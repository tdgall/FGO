  if(kind==='multi'){if(tot<30)return{ok:false,msg:`성정석이 부족합니다.<div class="dsub">필요 30 / 보유 ${fmtN(tot)}</div>`};return{ok:true,confirm:`성정석 <b>30</b>개를 소비하여<br><b>11회 소환</b>하시겠습니까?<div class="dsub">보유 성정석 ${fmtN(tot)} → ${fmtN(tot-30)}</div>`};}
  if(kind==='single'){const extra=S.single===9?'<div class="dsub hl">이번 소환은 보너스 소환 1회가 더해져 총 2회 소환됩니다!</div>':'';
    if(S.tk>0)return{ok:true,use:'tk',confirm:`호부 <b>1</b>장을 소비하여<br><b>1회 소환</b>하시겠습니까?<div class="dsub">보유 호부 ${fmtN(S.tk)} → ${fmtN(S.tk-1)}</div>${extra}`};
    if(tot<3)return{ok:false,msg:'성정석이 부족합니다.<div class="dsub">호부를 다 써서 성정석 3개가 필요합니다.</div>'};
    return{ok:true,use:'sq',confirm:`성정석 <b>3</b>개를 소비하여<br><b>1회 소환</b>하시겠습니까?<div class="dsub">보유 성정석 ${fmtN(tot)} → ${fmtN(tot-3)}</div>${extra}`};}
  if(S.daily===dayKey())return{ok:false,msg:'오늘은 이미 소환했습니다.<div class="dsub">매일 4시에 초기화됩니다.</div>'};
  if(S.paid<1)return{ok:false,msg:'유료 성정석이 부족합니다.<div class="dsub">MENU에서 보유 수량을 설정할 수 있습니다.</div>'};
  return{ok:true,confirm:'유료 성정석 <b>1</b>개를 소비하여<br><b>1회 소환</b>하시겠습니까?'};
}
function spendSQ(n){const a=Math.min(S.sq,n);S.sq-=a;S.sqUsed+=a;const b=n-a;S.paid-=b;S.paidUsed+=b;}
function pay(kind,can){if(kind==='multi')spendSQ(30);else if(kind==='single'){if(can.use==='tk'){S.tk--;S.tkUsed++;}else spendSQ(3);}else{S.paid--;S.paidUsed++;S.daily=dayKey();}}
let FORCE=null;
function rollCards(kind){
  let units=[];
  if(kind==='multi'){for(let i=0;i<11;i++)units.push(rollFrom(UNITS));const pick=f=>{const ix=units.map((u,i)=>f(u)?i:-1).filter(i=>i>=0);return ix[Math.floor(Math.random()*ix.length)];};if(!units.some(u=>u.r>=4)){units[pick(u=>u.r===3)]=rollFrom(POOL_R4);}if(!units.some(u=>u.type==='sv')){units[pick(u=>u.r===3)]=rollFrom(POOL_SV3);}}
  else{units.push(rollFrom(UNITS));if(kind==='single'){S.single++;if(S.single>=10){S.single=0;units.push(rollFrom(UNITS));}}}
  if(FORCE){FORCE.forEach(f=>{units[Math.min(f.i||0,units.length-1)]=BYID[f.id];});FORCE=null;}
  const cards=units.map(u=>{S.pity++;S.total++;let forced=false;if(S.pity>=330&&u.id!==PU){u=BYID[PU];forced=true;}if(u.id===PU)S.pity=0;const prev=S.roster[u.id]||0;S.roster[u.id]=prev+1;return{u,isNew:prev===0,count:prev+1,forced};});
  S.n++;S.hist.unshift({n:S.n,t:Date.now(),k:kind,ids:cards.map(c=>c.u.id)});if(S.hist.length>400)S.hist.length=400;
  return cards;
}
