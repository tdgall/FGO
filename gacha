let canvasK=0;
function fit(){
  const W=window.innerWidth,H=window.innerHeight;
  const coarse=!!(window.matchMedia&&matchMedia('(pointer:coarse)').matches);
  const rot=H>W&&coarse;
  const s=rot?Math.min(H/1280,W/720):Math.min(W/1280,H/720);
  stage.style.transform=`translate(-50%,-50%)${rot?' rotate(90deg)':''} scale(${s})`;
  const k=Math.max(1,Math.min(1.35,s*(window.devicePixelRatio||1)));
  if(Math.abs(k-canvasK)>.02){canvasK=k;FX.k=k;cv.width=Math.round(1280*k);cv.height=Math.round(720*k);}
}
window.addEventListener('resize',fit);window.addEventListener('orientationchange',()=>setTimeout(fit,250));
function buildBanner(){
  const pu=puU(),au=artURL(pu),isSil=au===SIL_ART[pu.cls];const ba=$('#bnArt');ba.style.backgroundImage=`url(${au})`;ba.style.backgroundSize=isSil?'cover':'';ba.style.backgroundPosition=isSil?'50% 20%':'';
  const nm=pu.name,l2=$('#bnPuName .ot');setOT(l2,nm);l2.style.fontSize=nm.length>7?Math.max(24,Math.round(46*7/nm.length))+'px':'';
  const t=`【10주년 기념】${nm} 픽업 소환`,bt=$('.bnName .ot');setOT(bt,t);bt.style.fontSize=t.length>22?Math.max(16,Math.round(25*22/t.length))+'px':'';
  $('.bnNote').textContent=`※ ${CLASSES[pu.cls][0]} 클래스 이외의 클래스도 소환되므로 주의 바랍니다.`;document.title=`영기소환 시뮬레이터 · ${nm} 픽업`;
  const fan=[['c3p',-15,140,32],['c4p',-7,198,18],['c5p',7,338,18],['c5_2',15,396,32]];
  $('#fan').innerHTML=fan.map(([id,r,l,t])=>`<div class="fc ${BYID[id].r>=4?'g':''}" style="left:${l}px;top:${t}px;transform:rotate(${r}deg);background-image:url(${artURL(BYID[id])})"></div>`).join('')+`<div class="fanEmb">${badge(puU().cls,5)}</div>`;
  $('#bnCE5').style.backgroundImage=`url(${artURL(BYID.c5p)})`;$('#bnCE4').style.backgroundImage=`url(${artURL(BYID.c4p)})`;$('#bnCE3').style.backgroundImage=`url(${artURL(BYID.c3p)})`;
  $('#icSq').innerHTML=IC_SQ;$('#icPq').innerHTML=IC_PQ;$('#icTk').innerHTML=IC_TK;
}
function warm(){const todo=UNITS.filter(u=>!artDone.has(u.id));let i=0;const step=()=>{if(i>=todo.length)return;artCls(todo[i++]);setTimeout(step,25);};setTimeout(step,400);}
window.SIM={
  force(id,i){FORCE=Array.isArray(id)?id:[{id:id||PU,i:i||0}];},
  test(N){N=N||200000;const c={};let ol=0,mOl=0,mGold=0,mSv=0;for(let i=0;i<N;i++){const u=rollFrom(UNITS);c[u.type+u.r]=(c[u.type+u.r]||0)+1;if(u.id==='olga')ol++;}
    const M=Math.floor(N/11);for(let k=0;k<M;k++){const a=[];for(let i=0;i<9;i++)a.push(rollFrom(UNITS));a.push(rollFrom(POOL_GOLD));a.push(rollFrom(POOL_SV));if(a.some(u=>u.r>=4))mGold++;if(a.some(u=>u.type==='sv'))mSv++;if(a.some(u=>u.id==='olga'))mOl++;}
    const out={};for(const k in c)out[k]=(c[k]/N*100).toFixed(3)+'%';out.olga=(ol/N*100).toFixed(3)+'%';out.multi_has_4star=(mGold/M*100).toFixed(2)+'%';out.multi_has_servant=(mSv/M*100).toFixed(2)+'%';out.multi_has_olga=(mOl/M*100).toFixed(2)+'%';
    let w=0;UNITS.forEach(u=>w+=u.w);out.weight_sum=w.toFixed(6);return out;},
  state(){return JSON.parse(JSON.stringify(S));}
};
