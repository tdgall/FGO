const IDB={db:null,mem:{},
  open(){return new Promise(res=>{try{const r=indexedDB.open('fgoSummonSim',1);r.onupgradeneeded=()=>{try{r.result.createObjectStore('img');}catch(e){}};r.onsuccess=()=>{IDB.db=r.result;res(true);};r.onerror=()=>res(false);r.onblocked=()=>res(false);}catch(e){res(false);}});},
  put(k,v){IDB.mem[k]=v;return new Promise(res=>{if(!IDB.db)return res(false);try{const t=IDB.db.transaction('img','readwrite');const st=t.objectStore('img');v==null?st.delete(k):st.put(v,k);t.oncomplete=()=>res(true);t.onerror=()=>res(false);}catch(e){res(false);}});},
  get(k){return new Promise(res=>{if(k in IDB.mem)return res(IDB.mem[k]);if(!IDB.db)return res(null);try{const q=IDB.db.transaction('img').objectStore('img').get(k);q.onsuccess=()=>res(q.result||null);q.onerror=()=>res(null);}catch(e){res(null);}});}};
