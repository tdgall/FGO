function openSetup(first){SU.first=!!first;const cur=puU();if(SU.tab==='sel'){SU.cls=cur.custom?SU.cls:cur.cls;SU.sel=cur.id;}openModal('setup','픽업 서번트 설정',suHTML());}
function suRender(){const st=mBody.scrollTop;mBody.innerHTML=suHTML();mBody.scrollTop=st;}
function setPickup(id){
  const changed=id!==S.pu.id;
  S.pu={id};S.puSet=true;if(changed)S.pity=0;applyPickup();save();buildBanner();updUI();closeModal();
  toast(changed?`${puName()} 픽업으로 설정했습니다 · 천장 카운트 0회`:`${puName()} 픽업 그대로 유지합니다`);
}
function fitImage(file,kind){return new Promise(res=>{const fr=new FileReader();fr.onload=()=>{const im=new Image();im.onload=()=>{
    let sx=0,sy=0,sw=im.width,sh=im.height,W,H;
    if(kind==='sq'){const s=Math.min(sw,sh);sx=(sw-s)/2;sy=(sh-s)/2;sw=sh=s;W=H=Math.min(256,s);}
    else{W=Math.min(360,sw);H=Math.round(sh*W/sw);}
    const c=document.createElement('canvas');c.width=W;c.height=H;const g=c.getContext('2d');g.imageSmoothingQuality='high';g.drawImage(im,sx,sy,sw,sh,0,0,W,H);
    let u=c.toDataURL('image/webp',.84);if(!u.startsWith('data:image/webp'))u=c.toDataURL('image/jpeg',.88);res(u);};im.onerror=()=>res(null);im.src=fr.result;};fr.onerror=()=>res(null);fr.readAsDataURL(file);});}
async function suAction(a){
  const [k,v]=a.split(':');
  if(k==='tab'){SU.tab=v;if(v==='sel'&&!suCands(SU.cls).length)SU.cls='saber';suRender();}
  else if(k==='cls'){if(SU.tab==='sel'){SU.cls=v;SU.sel=null;}else SU.cus.cls=v;suRender();}
  else if(k==='pick'){SU.sel=v;suRender();}
  else if(k==='goSel'){if(SU.sel)setPickup(SU.sel);}
  else if(k==='clr'){SU.cus[v]=null;suRender();}
  else if(k==='goCus'){const c=SU.cus,name=(c.name||'').trim();if(!name){toast('이름을 넣어 주세요');return;}
    S.cuN=(S.cuN||0)+1;const id='cu'+S.cuN;S.customs[id]={name,cls:c.cls};applyPickup();
    if(c.card||c.sq){await IDB.put(id+':card',c.card);await IDB.put(id+':sq',c.sq);setUnitArt(id,c.card,c.sq);}
    SU.cus={cls:c.cls,name:'',card:null,sq:null};setPickup(id);}
}
mBody.addEventListener('change',async e=>{if(modalKind!=='setup')return;const t=e.target;const a=t.dataset&&t.dataset.su;if(!a||!a.startsWith('file:'))return;const kind=a.slice(5);const f=t.files&&t.files[0];if(!f)return;
  const url=await fitImage(f,kind);if(!url){toast('이미지를 읽지 못했습니다');return;}SU.cus[kind==='sq'?'sq':'card']=url;suRender();});
mBody.addEventListener('input',e=>{if(modalKind==='setup'&&e.target.id==='suName')SU.cus.name=e.target.value;});

